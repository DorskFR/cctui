[Unit]
Description=cctui per-machine daemon
Documentation=https://github.com/DorskFR/cctui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cctui-daemon run
Restart=on-failure
RestartSec=5s

# The default (control-group) SIGTERMs every process in the unit's cgroup on
# stop/restart — which includes the `claude daemon` and every worker session the
# daemon spawned, so a routine restart killed all live sessions. `mixed` signals
# only the main process; the sessions survive and the daemon re-adopts them.
KillMode=mixed

# The daemon talks to the user's claude daemon control socket and reads
# ~/.claude — must run as the user, not root.
NoNewPrivileges=true
PrivateTmp=false

# NOTE: deliberately NO ProtectSystem=/ReadWritePaths= here. On a systemd
# --user service, mount-sandbox directives force the unprivileged user manager
# to wrap the unit in a USER NAMESPACE (uid_map "1000 1000 1", setgroups=deny),
# which drops every supplementary group — notably `docker`. The claude sessions
# the daemon spawns inherit that userns and lose docker-socket access
# (root:docker 0660 -> EACCES). As an unprivileged uid-1000 service, DAC already
# blocks writing system dirs, so these directives added little real confinement
# here while breaking docker. NoNewPrivileges (a prctl, not a userns trigger) stays.

[Install]
WantedBy=default.target
