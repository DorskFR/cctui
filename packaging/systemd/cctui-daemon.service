[Unit]
Description=cctui per-machine daemon
Documentation=https://github.com/DorskFR/cctui
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/cctui-daemon run
# SIGHUP re-execs the daemon in place onto the installed binary: same PID and
# cgroup, so live sessions are kept. Prefer this to a restart.
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=5s
# Coding agents run their tools (builds, Gradle/Kotlin daemons, test
# runners) as descendants of this unit. When the kernel OOM-kills one of
# them, the default OOMPolicy=stop would stop the whole unit and take every
# live Codex/opencode session down with it. Let the kernel kill the culprit
# and keep the daemon running.
OOMPolicy=continue

# `mixed` sends SIGTERM to the daemon alone, so it can hibernate the codex and
# opencode children it drives before systemd SIGKILLs whatever is left in the
# cgroup. A stop or restart therefore still ends those sessions; claude sessions
# live in claude-daemon.service and survive. Use `reload` (above) or
# `cctui-daemon update` to move to a new binary.
KillMode=mixed

# The daemon talks to the user's claude daemon control socket and reads
# ~/.claude — must run as the user, not root.
NoNewPrivileges=true
PrivateTmp=false

# NOTE: deliberately NO ProtectSystem=/ReadWritePaths= here. On a systemd
# --user service, mount-sandbox directives force the unprivileged user manager
# to wrap the unit in a USER NAMESPACE (uid_map "1000 1000 1", setgroups=deny),
# which drops every supplementary group — notably `docker`. The claude sessions
# the daemon spawns inherit that userns and lose docker-socket access
# (root:docker 0660 -> EACCES). As an unprivileged uid-1000 service, DAC already
# blocks writing system dirs, so these directives added little real confinement
# here while breaking docker. NoNewPrivileges (a prctl, not a userns trigger) stays.

[Install]
WantedBy=default.target
