[Unit]
Description=claude on-demand daemon (supervised, decoupled from cctui-daemon)
Documentation=https://github.com/DorskFR/cctui

[Service]
Type=simple
ExecStart=__CLAUDE_BIN__ daemon run
Restart=on-failure
RestartSec=5s

# A single OOM-killed child (e.g. a multi-GB tsc in a session turn) must not
# fail the whole unit: the default policy would tear down the supervisor and
# every live session job in this cgroup. The kernel already picked its victim.
OOMPolicy=continue

# Give the supervisor an augmented PATH so its own exec'd tooling resolves
# regardless of the (possibly minimal) inherited environment.
Environment=PATH=__CLAUDE_DAEMON_PATH__

# Separate unit so a cctui-daemon restart (KillMode=control-group) never kills
# the claude supervisor.

[Install]
WantedBy=default.target
