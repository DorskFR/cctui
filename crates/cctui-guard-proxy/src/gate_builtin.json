{
  "gates": {
    "noPush": {
      "protectedBranches": ["main", "master", "trunk"],
      "hosts": {
        "github.com": { "kind": "git", "push": "refuse" },
        "www.github.com": { "kind": "git", "push": "refuse" },
        "gist.github.com": { "kind": "git", "push": "refuse" },
        "uploads.github.com": { "kind": "rest" },
        "api.github.com": {
          "kind": "api",
          "rest": [
            { "method": "POST", "path": "{repo}/pulls" },
            {
              "method": "PATCH",
              "path": "{repo}/pulls/*",
              "check": { "onlyKeys": ["title", "body"] }
            },
            { "method": "POST", "path": "{repo}/issues" },
            { "method": "POST", "path": "{repo}/issues/*/comments" },
            { "method": "POST", "path": "{repo}/pulls/*/comments" },
            { "method": "POST", "path": "{repo}/issues/*/reactions" },
            { "method": "POST", "path": "{repo}/comments/*/reactions" },
            { "method": "POST", "path": "{repo}/issues/comments/*/reactions" },
            { "method": "POST", "path": "{repo}/pulls/comments/*/reactions" },
            { "method": "POST", "path": "{repo}/pulls/*/reviews" },
            { "method": "POST", "path": "{repo}/pulls/*/reviews/*/events" },
            { "method": "POST", "path": "{repo}/pulls/*/comments/*/replies" },
            { "method": "POST", "path": "{repo}/git/blobs" },
            { "method": "POST", "path": "{repo}/git/trees" },
            { "method": "POST", "path": "{repo}/git/commits" },
            { "method": "POST", "path": "{repo}/git/tags" },
            { "method": "PATCH", "path": "{repo}/issues/*" },
            {
              "method": ["PATCH", "DELETE"],
              "path": "{repo}/issues/comments/*"
            },
            {
              "method": ["PATCH", "DELETE"],
              "path": "{repo}/pulls/comments/*"
            },
            {
              "method": ["POST", "PUT", "DELETE"],
              "path": "{repo}/issues/*/labels"
            },
            { "method": "DELETE", "path": "{repo}/issues/*/labels/*" },
            { "method": "DELETE", "path": "{repo}/issues/*/reactions/*" },
            { "method": "DELETE", "path": "{repo}/comments/*/reactions/*" },
            {
              "method": "DELETE",
              "path": "{repo}/issues/comments/*/reactions/*"
            },
            {
              "method": "DELETE",
              "path": "{repo}/pulls/comments/*/reactions/*"
            },
            {
              "method": ["POST", "DELETE"],
              "path": "{repo}/issues/*/assignees"
            },
            {
              "method": ["POST", "DELETE"],
              "path": "{repo}/pulls/*/requested_reviewers"
            },
            { "method": ["PUT", "DELETE"], "path": "{repo}/pulls/*/reviews/*" }
          ],
          "mutations": [
            "createPullRequest",
            {
              "name": "updatePullRequest",
              "check": {
                "onlyKeys": [
                  "pullRequestId",
                  "title",
                  "body",
                  "clientMutationId"
                ]
              }
            },
            "markPullRequestReadyForReview",
            "convertPullRequestToDraft",
            "addComment",
            "updateIssueComment",
            "deleteIssueComment",
            "addReaction",
            "removeReaction",
            "createIssue",
            "updateIssue",
            "closeIssue",
            "reopenIssue",
            "addLabelsToLabelable",
            "removeLabelsFromLabelable",
            "addAssigneesToAssignable",
            "removeAssigneesFromAssignable",
            "addPullRequestReview",
            "submitPullRequestReview",
            "updatePullRequestReview",
            "deletePullRequestReview",
            "addPullRequestReviewComment",
            "updatePullRequestReviewComment",
            "deletePullRequestReviewComment",
            "addPullRequestReviewThread",
            "addPullRequestReviewThreadReply",
            "resolveReviewThread",
            "unresolveReviewThread",
            "requestReviews"
          ]
        }
      }
    },
    "draftPrOnly": {
      "protectedBranches": ["main", "master", "trunk"],
      "hosts": {
        "github.com": { "kind": "git", "push": "unprotectedBranches" },
        "www.github.com": { "kind": "git", "push": "unprotectedBranches" },
        "gist.github.com": { "kind": "git", "push": "unprotectedBranches" },
        "uploads.github.com": { "kind": "rest" },
        "api.github.com": {
          "kind": "api",
          "rest": [
            {
              "method": "POST",
              "path": "{repo}/pulls",
              "check": { "isTrue": "draft" }
            },
            {
              "method": "PATCH",
              "path": "{repo}/pulls/*",
              "check": { "onlyKeys": ["title", "body"] }
            },
            { "method": "PUT", "path": "{repo}/pulls/*/update-branch" },
            {
              "method": "POST",
              "path": "{repo}/git/refs",
              "check": { "refField": "ref" }
            },
            {
              "method": "*",
              "path": "{repo}/git/refs/heads/**",
              "check": "branchInPath"
            },
            {
              "method": "*",
              "path": "{repo}/contents/**",
              "check": { "branchField": "branch" }
            },
            {
              "method": "*",
              "path": "{repo}/merges",
              "check": { "branchField": "base" }
            },
            {
              "method": "*",
              "path": "{repo}/merge-upstream",
              "check": { "branchField": "branch" }
            },
            { "method": "POST", "path": "{repo}/issues" },
            { "method": "POST", "path": "{repo}/issues/*/comments" },
            { "method": "POST", "path": "{repo}/pulls/*/comments" },
            { "method": "POST", "path": "{repo}/issues/*/reactions" },
            { "method": "POST", "path": "{repo}/comments/*/reactions" },
            { "method": "POST", "path": "{repo}/issues/comments/*/reactions" },
            { "method": "POST", "path": "{repo}/pulls/comments/*/reactions" },
            { "method": "POST", "path": "{repo}/pulls/*/reviews" },
            { "method": "POST", "path": "{repo}/pulls/*/reviews/*/events" },
            { "method": "POST", "path": "{repo}/pulls/*/comments/*/replies" },
            { "method": "POST", "path": "{repo}/git/blobs" },
            { "method": "POST", "path": "{repo}/git/trees" },
            { "method": "POST", "path": "{repo}/git/commits" },
            { "method": "POST", "path": "{repo}/git/tags" },
            { "method": "PATCH", "path": "{repo}/issues/*" },
            {
              "method": ["PATCH", "DELETE"],
              "path": "{repo}/issues/comments/*"
            },
            {
              "method": ["PATCH", "DELETE"],
              "path": "{repo}/pulls/comments/*"
            },
            {
              "method": ["POST", "PUT", "DELETE"],
              "path": "{repo}/issues/*/labels"
            },
            { "method": "DELETE", "path": "{repo}/issues/*/labels/*" },
            { "method": "DELETE", "path": "{repo}/issues/*/reactions/*" },
            { "method": "DELETE", "path": "{repo}/comments/*/reactions/*" },
            {
              "method": "DELETE",
              "path": "{repo}/issues/comments/*/reactions/*"
            },
            {
              "method": "DELETE",
              "path": "{repo}/pulls/comments/*/reactions/*"
            },
            {
              "method": ["POST", "DELETE"],
              "path": "{repo}/issues/*/assignees"
            },
            {
              "method": ["POST", "DELETE"],
              "path": "{repo}/pulls/*/requested_reviewers"
            },
            { "method": ["PUT", "DELETE"], "path": "{repo}/pulls/*/reviews/*" }
          ],
          "mutations": [
            { "name": "createPullRequest", "check": { "isTrue": "draft" } },
            {
              "name": "updatePullRequest",
              "check": {
                "onlyKeys": [
                  "pullRequestId",
                  "title",
                  "body",
                  "clientMutationId"
                ]
              }
            },
            "updatePullRequestBranch",
            "convertPullRequestToDraft",
            "addComment",
            "updateIssueComment",
            "deleteIssueComment",
            "addReaction",
            "removeReaction",
            "createIssue",
            "updateIssue",
            "closeIssue",
            "reopenIssue",
            "addLabelsToLabelable",
            "removeLabelsFromLabelable",
            "addAssigneesToAssignable",
            "removeAssigneesFromAssignable",
            "addPullRequestReview",
            "submitPullRequestReview",
            "updatePullRequestReview",
            "deletePullRequestReview",
            "addPullRequestReviewComment",
            "updatePullRequestReviewComment",
            "deletePullRequestReviewComment",
            "addPullRequestReviewThread",
            "addPullRequestReviewThreadReply",
            "resolveReviewThread",
            "unresolveReviewThread",
            "requestReviews"
          ]
        }
      }
    }
  }
}
