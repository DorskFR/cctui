{
  "name": "cctui-ghreview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "gen:openapi": "bun run scripts/gen-openapi.ts",
    "gen:client": "bun run scripts/gen-openapi.ts && openapi-typescript openapi.json -o src/generated/api.ts",
    "gen:graphql": "graphql-codegen --config codegen.ts",
    "gen": "bun run gen:client && bun run gen:graphql",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "overrides": {
    "brace-expansion": "^5.0.8",
    "js-yaml": "^4.3.0"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.5.1",
    "@octokit/graphql": "^9.0.3",
    "@octokit/rest": "^22.0.1",
    "hono": "^4.12.32",
    "postgres": "^3.4.9",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@graphql-codegen/cli": "^7.2.0",
    "@graphql-codegen/typescript": "^6.1.0",
    "@graphql-codegen/typescript-operations": "^6.1.2",
    "@types/bun": "^1.3.14",
    "graphql": "^17.0.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^7.0.2"
  }
}
