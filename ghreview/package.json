{
  "name": "cctui-ghreview",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "module": "src/index.ts",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "start": "bun run src/index.ts",
    "gen:openapi": "bun run scripts/gen-openapi.ts",
    "gen:client": "bun run scripts/gen-openapi.ts && openapi-typescript openapi.json -o src/generated/api.ts",
    "gen": "bun run gen:client",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "test": "bun test",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "dependencies": {
    "@hono/zod-openapi": "^1.1.4",
    "hono": "^4.10.4",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.9",
    "@types/bun": "^1.3.14",
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.3"
  }
}
