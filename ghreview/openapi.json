{
  "openapi": "3.0.3",
  "info": {
    "title": "cctui gh-review API",
    "version": "0.0.1",
    "description": "Versioned HTTP+SSE contract for the GitHub review center. Relays GitHub-shaped JSONB payloads verbatim inside typed envelopes."
  },
  "servers": [
    {
      "url": "/"
    }
  ],
  "components": {
    "schemas": {
      "SseEvent": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/PrUpdatedEvent"
          },
          {
            "$ref": "#/components/schemas/NotificationNewEvent"
          },
          {
            "$ref": "#/components/schemas/NotificationUpdatedEvent"
          },
          {
            "$ref": "#/components/schemas/SyncStatusEvent"
          }
        ],
        "discriminator": {
          "propertyName": "event",
          "mapping": {
            "pr.updated": "#/components/schemas/PrUpdatedEvent",
            "notification.new": "#/components/schemas/NotificationNewEvent",
            "notification.updated": "#/components/schemas/NotificationUpdatedEvent",
            "sync.status": "#/components/schemas/SyncStatusEvent"
          }
        }
      },
      "PrUpdatedEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "pr.updated"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "account": {
                "type": "string",
                "minLength": 1,
                "example": "DorskFR",
                "description": "GitHub account/login the record was synced for"
              },
              "owner": {
                "type": "string"
              },
              "repo": {
                "type": "string"
              },
              "number": {
                "type": "integer",
                "minimum": 0,
                "exclusiveMinimum": true
              }
            },
            "required": [
              "account",
              "owner",
              "repo",
              "number"
            ]
          }
        },
        "required": [
          "event",
          "data"
        ]
      },
      "NotificationNewEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "notification.new"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "account": {
                "type": "string",
                "minLength": 1,
                "example": "DorskFR",
                "description": "GitHub account/login the record was synced for"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "account",
              "id"
            ]
          }
        },
        "required": [
          "event",
          "data"
        ]
      },
      "NotificationUpdatedEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "notification.updated"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "account": {
                "type": "string",
                "minLength": 1,
                "example": "DorskFR",
                "description": "GitHub account/login the record was synced for"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "account",
              "id"
            ]
          }
        },
        "required": [
          "event",
          "data"
        ]
      },
      "SyncStatusEvent": {
        "type": "object",
        "properties": {
          "event": {
            "type": "string",
            "enum": [
              "sync.status"
            ]
          },
          "data": {
            "type": "object",
            "properties": {
              "account": {
                "type": "string",
                "minLength": 1,
                "example": "DorskFR",
                "description": "GitHub account/login the record was synced for"
              },
              "state": {
                "type": "string",
                "enum": [
                  "idle",
                  "syncing",
                  "error"
                ]
              },
              "last_run": {
                "type": "string",
                "nullable": true,
                "format": "date-time"
              }
            },
            "required": [
              "account",
              "state",
              "last_run"
            ]
          }
        },
        "required": [
          "event",
          "data"
        ]
      },
      "Status": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string",
            "enum": [
              "gh-review"
            ]
          },
          "version": {
            "type": "string",
            "example": "0.0.1"
          },
          "api": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "ok": {
            "type": "boolean"
          },
          "sync": {
            "$ref": "#/components/schemas/SyncStatus"
          }
        },
        "required": [
          "service",
          "version",
          "api",
          "ok",
          "sync"
        ]
      },
      "SyncStatus": {
        "type": "object",
        "properties": {
          "last_run": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "accounts": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "example": "DorskFR",
              "description": "GitHub account/login the record was synced for"
            }
          }
        },
        "required": [
          "last_run",
          "accounts"
        ]
      },
      "AccountList": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AccountSummary"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "AccountSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "example": "DorskFR",
            "description": "GitHub account/login the record was synced for"
          },
          "poll_interval_ms": {
            "type": "integer",
            "nullable": true
          },
          "budget_ceiling": {
            "type": "number",
            "nullable": true
          },
          "rate_limit": {
            "type": "integer",
            "nullable": true
          },
          "active": {
            "type": "boolean"
          },
          "created_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "id",
          "login",
          "poll_interval_ms",
          "budget_ceiling",
          "rate_limit",
          "active",
          "created_at"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found",
                "description": "Stable machine-readable error code"
              },
              "message": {
                "type": "string",
                "example": "Pull request not found"
              },
              "details": {
                "type": "object",
                "description": "Optional structured context"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "AccountCreate": {
        "type": "object",
        "properties": {
          "token": {
            "type": "string",
            "minLength": 1,
            "description": "GitHub PAT (fine-grained preferred); validated, sealed, never returned"
          },
          "login": {
            "type": "string",
            "minLength": 1,
            "description": "Expected login; rejected if it does not match the PAT's account"
          },
          "poll_interval_ms": {
            "type": "integer",
            "minimum": 1000
          },
          "budget_ceiling": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "rate_limit": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "token"
        ]
      },
      "RepoPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RepoEnvelope"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor for the next page, or null at the end",
            "example": null
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "RepoEnvelope": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "example": "DorskFR",
            "description": "GitHub account/login the record was synced for"
          },
          "kind": {
            "type": "string",
            "enum": [
              "repo"
            ],
            "example": "repo"
          },
          "synced_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T09:00:00Z",
            "description": "When the server last synced this record"
          },
          "etag": {
            "type": "string",
            "nullable": true,
            "example": "W/\"a1b2c3\"",
            "description": "GitHub ETag captured at sync time, if any"
          },
          "payload": {
            "type": "object",
            "description": "GitHub-shaped JSONB payload, relayed verbatim (narrow with octokit types)"
          }
        },
        "required": [
          "account",
          "kind",
          "synced_at",
          "etag"
        ]
      },
      "PullRequestPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/PullRequestEnvelope"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor for the next page, or null at the end",
            "example": null
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "PullRequestEnvelope": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "example": "DorskFR",
            "description": "GitHub account/login the record was synced for"
          },
          "kind": {
            "type": "string",
            "enum": [
              "pull_request"
            ],
            "example": "pull_request"
          },
          "synced_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T09:00:00Z",
            "description": "When the server last synced this record"
          },
          "etag": {
            "type": "string",
            "nullable": true,
            "example": "W/\"a1b2c3\"",
            "description": "GitHub ETag captured at sync time, if any"
          },
          "payload": {
            "type": "object",
            "description": "GitHub-shaped JSONB payload, relayed verbatim (narrow with octokit types)"
          }
        },
        "required": [
          "account",
          "kind",
          "synced_at",
          "etag"
        ]
      },
      "NotificationInboxPage": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationInboxItem"
            }
          },
          "next_cursor": {
            "type": "string",
            "nullable": true,
            "description": "Cursor for the next page, or null at the end",
            "example": null
          }
        },
        "required": [
          "items",
          "next_cursor"
        ]
      },
      "NotificationInboxItem": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "example": "DorskFR",
            "description": "GitHub account/login the record was synced for"
          },
          "kind": {
            "type": "string",
            "enum": [
              "notification"
            ],
            "example": "notification"
          },
          "synced_at": {
            "type": "string",
            "format": "date-time",
            "example": "2026-07-12T09:00:00Z",
            "description": "When the server last synced this record"
          },
          "etag": {
            "type": "string",
            "nullable": true,
            "example": "W/\"a1b2c3\"",
            "description": "GitHub ETag captured at sync time, if any"
          },
          "payload": {
            "type": "object",
            "description": "GitHub-shaped JSONB payload, relayed verbatim (narrow with octokit types)"
          },
          "state": {
            "$ref": "#/components/schemas/NotificationState"
          }
        },
        "required": [
          "account",
          "kind",
          "synced_at",
          "etag",
          "state"
        ]
      },
      "NotificationState": {
        "type": "object",
        "properties": {
          "read": {
            "type": "boolean",
            "description": "Locally marked read (also pushed to GitHub)"
          },
          "done": {
            "type": "boolean",
            "description": "Locally marked done (local-only state)"
          },
          "archived": {
            "type": "boolean",
            "description": "Locally archived (local-only state)"
          },
          "read_at": {
            "type": "string",
            "nullable": true
          },
          "done_at": {
            "type": "string",
            "nullable": true
          },
          "archived_at": {
            "type": "string",
            "nullable": true
          },
          "push_pending": {
            "type": "boolean",
            "description": "A mark-as-read still owed to GitHub; retried on the next poll"
          },
          "last_error": {
            "type": "string",
            "nullable": true,
            "description": "Last push failure, if any"
          },
          "updated_at": {
            "type": "string",
            "nullable": true
          }
        },
        "required": [
          "read",
          "done",
          "archived",
          "read_at",
          "done_at",
          "archived_at",
          "push_pending",
          "last_error",
          "updated_at"
        ]
      },
      "NotificationStateResult": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/NotificationStateItem"
            }
          }
        },
        "required": [
          "items"
        ]
      },
      "NotificationStateItem": {
        "type": "object",
        "properties": {
          "thread_id": {
            "type": "string"
          },
          "state": {
            "$ref": "#/components/schemas/NotificationState"
          }
        },
        "required": [
          "thread_id",
          "state"
        ]
      },
      "NotificationBulkState": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "example": "DorskFR",
            "description": "GitHub account/login the record was synced for"
          },
          "thread_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1,
            "maxItems": 200,
            "description": "Notification thread ids to mutate"
          },
          "read": {
            "type": "boolean",
            "description": "Set read; true pushes to GitHub"
          },
          "done": {
            "type": "boolean",
            "description": "Set done (local-only)"
          },
          "archived": {
            "type": "boolean",
            "description": "Set archived (local-only)"
          }
        },
        "required": [
          "account",
          "thread_ids"
        ]
      },
      "NotificationSingleState": {
        "type": "object",
        "properties": {
          "account": {
            "type": "string",
            "minLength": 1,
            "example": "DorskFR",
            "description": "GitHub account/login the record was synced for"
          },
          "read": {
            "type": "boolean",
            "description": "Set read; true pushes to GitHub"
          },
          "done": {
            "type": "boolean",
            "description": "Set done (local-only)"
          },
          "archived": {
            "type": "boolean",
            "description": "Set archived (local-only)"
          }
        },
        "required": [
          "account"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/v1/health": {
      "get": {
        "summary": "Liveness probe",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Service is up",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "ok"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/v1/status": {
      "get": {
        "summary": "Service and sync status",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Current service and sync status",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Status"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts": {
      "get": {
        "summary": "List the caller's GitHub accounts (no secrets)",
        "tags": [
          "accounts"
        ],
        "responses": {
          "200": {
            "description": "The caller's accounts",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountList"
                }
              }
            }
          },
          "503": {
            "description": "Store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "post": {
        "summary": "Add a GitHub account (validates the PAT, seals it, never returns it)",
        "tags": [
          "accounts"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AccountCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The created account (no secrets)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountSummary"
                }
              }
            }
          },
          "400": {
            "description": "Invalid PAT",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Login already owned",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Store/sealer unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/accounts/{id}": {
      "delete": {
        "summary": "Remove one of the caller's GitHub accounts",
        "tags": [
          "accounts"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "1"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "responses": {
          "204": {
            "description": "Deleted"
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/repos": {
      "get": {
        "summary": "List synced repositories",
        "tags": [
          "repos"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "DorskFR",
              "description": "Filter to a single account; omit to span all synced accounts"
            },
            "required": false,
            "description": "Filter to a single account; omit to span all synced accounts",
            "name": "account",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "example": 30
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Opaque cursor from a previous page's next_cursor"
            },
            "required": false,
            "description": "Opaque cursor from a previous page's next_cursor",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of repository envelopes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepoPage"
                }
              }
            }
          }
        }
      }
    },
    "/v1/repos/{owner}/{repo}": {
      "get": {
        "summary": "Get a synced repository",
        "tags": [
          "repos"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "DorskFR"
            },
            "required": true,
            "name": "owner",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "example": "cctui"
            },
            "required": true,
            "name": "repo",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The repository envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RepoEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not synced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/repos/{owner}/{repo}/pulls": {
      "get": {
        "summary": "List synced pull requests for a repository",
        "tags": [
          "pulls"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "DorskFR"
            },
            "required": true,
            "name": "owner",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "example": "cctui"
            },
            "required": true,
            "name": "repo",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "DorskFR",
              "description": "Filter to a single account; omit to span all synced accounts"
            },
            "required": false,
            "description": "Filter to a single account; omit to span all synced accounts",
            "name": "account",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "example": 30
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Opaque cursor from a previous page's next_cursor"
            },
            "required": false,
            "description": "Opaque cursor from a previous page's next_cursor",
            "name": "cursor",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of pull request envelopes",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullRequestPage"
                }
              }
            }
          }
        }
      }
    },
    "/v1/repos/{owner}/{repo}/pulls/{number}": {
      "get": {
        "summary": "Get a synced pull request",
        "tags": [
          "pulls"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "DorskFR"
            },
            "required": true,
            "name": "owner",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "example": "cctui"
            },
            "required": true,
            "name": "repo",
            "in": "path"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 0,
              "exclusiveMinimum": true,
              "example": 42
            },
            "required": true,
            "name": "number",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The pull request envelope",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PullRequestEnvelope"
                }
              }
            }
          },
          "404": {
            "description": "Not synced",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications": {
      "get": {
        "summary": "The notifications inbox feed (documents + local state)",
        "tags": [
          "notifications"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "example": "DorskFR",
              "description": "Filter to a single account; omit to span all synced accounts"
            },
            "required": false,
            "description": "Filter to a single account; omit to span all synced accounts",
            "name": "account",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 30,
              "example": 30
            },
            "required": false,
            "name": "limit",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "Opaque cursor from a previous page's next_cursor"
            },
            "required": false,
            "description": "Opaque cursor from a previous page's next_cursor",
            "name": "cursor",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "description": "GitHub reason (review_requested/mention/ci_activity; aliases review-requested/ci)"
            },
            "required": false,
            "description": "GitHub reason (review_requested/mention/ci_activity; aliases review-requested/ci)",
            "name": "reason",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "example": "DorskFR/cctui",
              "description": "Filter by repository full name"
            },
            "required": false,
            "description": "Filter by repository full name",
            "name": "repo",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "true: only unread & not locally read; false: read"
            },
            "required": false,
            "description": "true: only unread & not locally read; false: read",
            "name": "unread",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "true: only not-done; false: only done"
            },
            "required": false,
            "description": "true: only not-done; false: only done",
            "name": "undone",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "enum": [
                "true",
                "false"
              ],
              "description": "true: only archived; default/false: hide archived"
            },
            "required": false,
            "description": "true: only archived; default/false: hide archived",
            "name": "archived",
            "in": "query"
          },
          {
            "schema": {
              "type": "string",
              "format": "date-time",
              "description": "Only notifications updated at/after this ISO timestamp"
            },
            "required": false,
            "description": "Only notifications updated at/after this ISO timestamp",
            "name": "since",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "A page of inbox items (envelope + read/done/archived state)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationInboxPage"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/state": {
      "post": {
        "summary": "Bulk mark notifications read/done/archived",
        "tags": [
          "notifications"
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationBulkState"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated state for each thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationStateResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "State store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/notifications/{id}/state": {
      "post": {
        "summary": "Mark one notification read/done/archived",
        "tags": [
          "notifications"
        ],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "example": "thread-42"
            },
            "required": true,
            "name": "id",
            "in": "path"
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/NotificationSingleState"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "The updated state for the thread",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotificationStateResult"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "State store unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/events": {
      "get": {
        "summary": "Server-Sent Events stream",
        "description": "text/event-stream of the documented event catalogue. Each message carries an `event:` name (pr.updated, notification.new, notification.updated, sync.status) and a JSON `data:` payload matching SseEvent.",
        "tags": [
          "events"
        ],
        "responses": {
          "200": {
            "description": "An SSE stream of SseEvent messages",
            "content": {
              "text/event-stream": {
                "schema": {
                  "$ref": "#/components/schemas/SseEvent"
                }
              }
            }
          }
        }
      }
    },
    "/v1/webhook": {
      "post": {
        "summary": "GitHub webhook ingestion",
        "description": "Optional push path for org repos that can install a webhook. Verifies X-Hub-Signature-256 (HMAC-SHA256 of the raw body with the shared secret) and upserts the payload exactly like a poll result. Polling remains the universal path.",
        "tags": [
          "events"
        ],
        "responses": {
          "202": {
            "description": "Accepted and stored"
          },
          "401": {
            "description": "Missing or invalid signature"
          }
        }
      }
    }
  }
}
