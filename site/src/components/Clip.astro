---
import { withBase } from '../lib/base';

interface Props {
  slug: string;
  alt: string;
  lazy?: boolean;
  ratio?: string;
  class?: string;
}

const { slug, alt, lazy = false, ratio = '16 / 10', class: className = '' } = Astro.props;
const media = (ext: string) => withBase(`media/${slug}.${ext}`);
---

<figure class:list={['clip', className]} style={`aspect-ratio: ${ratio}`} data-clip={slug}>
  <video
    muted
    loop
    playsinline
    disablepictureinpicture
    autoplay={!lazy}
    preload={lazy ? 'none' : 'metadata'}
    poster={media('poster.webp')}
    aria-label={alt}
    data-lazy={lazy ? '' : undefined}
  >
    <source src={media('mp4')} type="video/mp4" />
  </video>
  <div class="clip-missing" aria-hidden="true">
    <span class="clip-glyph">&gt;_</span>
    <span>{alt}</span>
  </div>
</figure>

<script>
  const clips = document.querySelectorAll<HTMLElement>('.clip');
  for (const clip of clips) {
    const video = clip.querySelector('video');
    if (!video) continue;
    const lastSource = video.querySelector('source:last-of-type');
    lastSource?.addEventListener('error', () => clip.classList.add('is-missing'));
  }

  const lazy = document.querySelectorAll<HTMLVideoElement>('video[data-lazy]');
  if (lazy.length && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          const v = e.target as HTMLVideoElement;
          if (e.isIntersecting) {
            if (v.preload === 'none') v.preload = 'metadata';
            v.play().catch(() => {});
          } else {
            v.pause();
          }
        }
      },
      { rootMargin: '120px 0px', threshold: 0.15 },
    );
    for (const v of lazy) io.observe(v);
  } else {
    for (const v of lazy) v.play().catch(() => {});
  }
</script>

<style>
  .clip {
    position: relative;
    margin: 0;
    width: 100%;
    overflow: hidden;
    border-radius: 12px;
    border: 1px solid var(--c-border, #2c323d);
    background: var(--c-bg-elev, #171a21);
    box-shadow: var(--shadow-md, 0 6px 20px rgba(0, 0, 0, 0.35));
  }
  .clip video {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    background: var(--c-bg, #0f1115);
  }
  .clip-missing {
    position: absolute;
    inset: 0;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 1rem;
    text-align: center;
    color: var(--c-text-faint, #848c9e);
    font-size: 0.9rem;
    background:
      linear-gradient(135deg, rgba(90, 214, 160, 0.06), transparent 60%),
      var(--c-bg-elev, #171a21);
  }
  .clip-glyph {
    font-family: var(--font-mono, ui-monospace, monospace);
    font-size: 1.6rem;
    color: var(--c-accent, #5ad6a0);
  }
  .clip.is-missing video {
    visibility: hidden;
  }
  .clip.is-missing .clip-missing {
    display: flex;
  }
</style>
