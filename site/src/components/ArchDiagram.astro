---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<svg
  class:list={['arch', { compact }]}
  viewBox="0 0 1100 420"
  role="img"
  aria-labelledby="arch-title arch-desc"
  xmlns="http://www.w3.org/2000/svg"
>
  <title id="arch-title">cctui architecture</title>
  <desc id="arch-desc">
    Browsers and the terminal client talk to cctui-server over HTTPS and WebSocket. Each machine runs
    cctui-daemon, which connects out to the server and drives Claude Code, Codex, opencode and ACP agents.
    Dispatchers connect out too and create ephemeral Kubernetes worker pods with a guard-proxy sidecar.
    Model providers are reached through the server's gateway.
  </desc>
  <defs>
    <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
      <path d="M0 0L10 5L0 10z" fill="currentColor" />
    </marker>
  </defs>

  <g class="box clients" transform="translate(10 40)">
    <rect width="220" height="120" rx="12" />
    <text x="16" y="30" class="h">You</text>
    <text x="16" y="58">Web UI (phone + desktop)</text>
    <text x="16" y="82">cctui terminal client</text>
    <text x="16" y="106">cctui-admin</text>
  </g>

  <g class="box server" transform="translate(320 20)">
    <rect width="440" height="170" rx="12" />
    <text x="16" y="30" class="h">cctui-server</text>
    <text x="16" y="58">sessions, events, full-text search (PostgreSQL)</text>
    <text x="16" y="82">WebSocket hub, REST API, plugin host</text>
    <text x="16" y="106">gateway: accounts, pools, rate limits, $ caps</text>
    <text x="16" y="130">encrypted vault, authz, signed manifests</text>
    <text x="16" y="154">rooms, peers, cctuiverse links</text>
  </g>

  <g class="box providers" transform="translate(860 40)">
    <rect width="230" height="120" rx="12" />
    <text x="16" y="30" class="h">Model providers</text>
    <text x="16" y="58">Anthropic, OpenAI</text>
    <text x="16" y="82">compatible endpoints</text>
    <text x="16" y="106">your own LAN models</text>
  </g>

  <g class="box daemon" transform="translate(40 260)">
    <rect width="420" height="130" rx="12" />
    <text x="16" y="30" class="h">Your machines</text>
    <text x="16" y="58">cctui-daemon (outbound WS, self-updates)</text>
    <text x="16" y="82">Claude Code / Codex / opencode / ACP</text>
    <text x="16" y="106">MCP tools: CctuiAgent, CctuiSend, ...</text>
  </g>

  <g class="box workers" transform="translate(600 260)">
    <rect width="460" height="130" rx="12" />
    <text x="16" y="30" class="h">Kubernetes workers</text>
    <text x="16" y="58">dispatcher (outbound WS) + WorkerProfile CRD</text>
    <text x="16" y="82">one Job per dispatch, sandboxed supervisor</text>
    <text x="16" y="106">guard-proxy sidecar: egress policy, no raw secrets</text>
  </g>

  <g class="edges">
    <path d="M230 100 H320" marker-end="url(#arr)" marker-start="url(#arr)" />
    <path d="M760 100 H860" marker-end="url(#arr)" />
    <path d="M250 260 V190 H320" marker-end="url(#arr)" />
    <path d="M830 260 V190 H760" marker-end="url(#arr)" />
  </g>
  <g class="labels">
    <text x="275" y="90" text-anchor="middle">https + ws</text>
    <text x="810" y="90" text-anchor="middle">gateway</text>
    <text x="258" y="230" text-anchor="start">enroll, stream</text>
    <text x="822" y="230" text-anchor="end">dispatch, status</text>
  </g>
</svg>

<style>
  .arch {
    width: 100%;
    height: auto;
    font-family: var(--font-sans, system-ui, sans-serif);
    font-size: 15px;
    color: var(--c-text-muted, #9aa3b2);
  }
  .arch .box rect {
    fill: var(--c-bg-elev, #171a21);
    stroke: var(--c-border, #2c323d);
    stroke-width: 1.5;
  }
  .arch .box text {
    fill: var(--c-text-muted, #9aa3b2);
  }
  .arch .box text.h {
    fill: var(--c-text, #e6e9ef);
    font-weight: 700;
    font-size: 17px;
  }
  .arch .server rect {
    stroke: var(--c-accent, #5ad6a0);
  }
  .arch .server text.h {
    fill: var(--c-accent, #5ad6a0);
  }
  .arch .workers rect {
    stroke: var(--c-violet, #b48ef0);
  }
  .arch .daemon rect {
    stroke: var(--c-blue, #5aa9ff);
  }
  .arch .edges path {
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
  }
  .arch .labels text {
    fill: var(--c-text-faint, #848c9e);
    font-size: 13px;
  }
  .arch.compact {
    font-size: 16px;
  }
</style>
