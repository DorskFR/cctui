---
import { withBase } from '../lib/base';

interface Props {
  src: string;
  alt: string;
  caption?: string;
}

const { src, alt, caption } = Astro.props;
---

<figure class="shot">
  <img src={withBase(`shots/${src}`)} alt={alt} loading="lazy" decoding="async" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .shot {
    margin: 1.5rem 0;
  }
  .shot img {
    display: block;
    width: 100%;
    border-radius: 12px;
    border: 1px solid var(--c-border, #2c323d);
    box-shadow: var(--shadow-md, 0 6px 20px rgba(0, 0, 0, 0.35));
  }
  figcaption {
    margin-top: 0.5rem;
    font-size: 0.85rem;
    color: var(--c-text-muted, #9aa3b2);
  }
</style>
