{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": false,
  "files": {
    "includes": [
      "src/**/*.ts",
      "plugin-sdk/**/*.ts",
      "plugin-runtime.vite.ts",
      "!src/lib/paraglide/**",
      "!src/lib/bindings/**",
      "!**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noControlCharactersInRegex": "off"
      },
      "correctness": {
        "noUnsafeOptionalChaining": "warn"
      },
      "style": {
        "noRestrictedGlobals": {
          "level": "error",
          "options": {
            "deniedGlobals": {
              "confirm": "Use confirmDialog() from $lib/confirmDialog.svelte, or a ConfirmModal with tone=\"danger\".",
              "alert": "Show a toast or an inline Callout instead of a native alert().",
              "prompt": "Use a Modal with an input (EditEntityModal) instead of a native prompt()."
            }
          }
        }
      }
    }
  }
}
