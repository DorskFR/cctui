{
  "$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
  "root": false,
  "files": {
    "includes": [
      "src/**/*.ts",
      "plugin-sdk/**/*.ts",
      "plugin-runtime.vite.ts",
      "!src/lib/paraglide/**",
      "!src/lib/bindings/**",
      "!**/*.d.ts"
    ]
  },
  "formatter": {
    "enabled": false
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "noControlCharactersInRegex": "off"
      },
      "correctness": {
        "noUnsafeOptionalChaining": "warn"
      }
    }
  }
}
