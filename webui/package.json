{
  "name": "cctui-webui",
  "private": true,
  "version": "0.8.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview --host",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prepare": "npm run paraglide && (svelte-kit sync || echo '')",
    "check": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run paraglide && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "bindings": "bash scripts/gen-bindings.sh",
    "test": "npm run paraglide && vitest run",
    "lint": "biome lint ."
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@inlang/paraglide-js": "^2.24.1",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.2.0",
    "happy-dom": "^20.10.6",
    "svelte": "^5.25.0",
    "svelte-check": "^4.0.0",
    "typescript": "^5.0.0",
    "vite": "^7.0.0",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@dorsk/tsumikit": "^0.38.1",
    "@tanstack/query-async-storage-persister": "^5.101.4",
    "@tanstack/svelte-query": "^6.1.38",
    "@tanstack/svelte-query-persist-client": "^6.1.38",
    "@xterm/xterm": "^6.0.0",
    "cctui-ghreview-ui": "file:../ghreview-ui",
    "highlight.js": "^11.11.1",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0"
  }
}
