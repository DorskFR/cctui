{
  "name": "cctui-webui",
  "private": true,
  "version": "0.24.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "scripts": {
    "preinstall": "case \"$npm_config_user_agent\" in npm/*) exit 0 ;; esac; echo '' >&2; echo 'webui is an npm project (package-lock.json).' >&2; echo 'Run: npm ci' >&2; echo '' >&2; exit 1",
    "dev": "vite dev",
    "build": "npm run codegen:ensure && vite build",
    "preview": "vite preview --host",
    "paraglide": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide",
    "prepare": "npm run codegen && (svelte-kit sync || echo '')",
    "codegen": "npm run paraglide && npm run journey:compile",
    "codegen:ensure": "node scripts/codegen-ensure.mjs",
    "check": "npm run codegen:ensure && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "npm run codegen:ensure && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "bindings": "bash scripts/gen-bindings.sh && node scripts/gen-scrub-detectors.mjs",
    "pretest": "npm run codegen:ensure",
    "test": "vitest run",
    "lint": "biome lint .",
    "plugins:local": "vite build --config ../deploy/local/plugins/pagedemo/vite.config.ts",
    "journey:compile": "journey compile --public -o src/lib/journeys.generated.json",
    "journey:ir": "node scripts/journey-ir.mjs",
    "journey:seed": "bash ../deploy/local/fixture/seed.sh",
    "journey:auth": "node scripts/journey-auth.mjs",
    "journey:changed": "node scripts/journeys-for-changes.mjs",
    "journey:compress": "node scripts/journey-compress.mjs",
    "journey:shoot": "node scripts/journey-shoot.mjs",
    "journey:book": "npm run journey:shoot -- --all"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@dorsk/journey": "^0.8.2",
    "@inlang/paraglide-js": "^2.25.4",
    "@playwright/test": "^1.63.0",
    "@sveltejs/adapter-static": "^3.0.8",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "@types/node": "^26.6.2",
    "happy-dom": "^20.14.5",
    "sharp": "^0.35.4",
    "svelte": "^5.57.1",
    "svelte-check": "^4.7.6",
    "typescript": "^5.0.0",
    "vite": "^8.3.1",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@dorsk/journey": "^0.8.2",
    "@dorsk/tsumikit": "^0.67.0",
    "@tanstack/query-async-storage-persister": "^5.103.2",
    "@tanstack/svelte-query": "^6.2.4",
    "@tanstack/svelte-query-persist-client": "^6.2.4",
    "@xterm/xterm": "^6.0.0",
    "highlight.js": "^11.12.0",
    "html-to-image": "^1.11.13",
    "idb-keyval": "^6.3.0"
  }
}
