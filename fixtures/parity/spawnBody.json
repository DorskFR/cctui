        "permission_mode": "ask",
        "effort": "medium",
        "service_tier": "fast",
        "model": "gpt-5.6-sol",
        "account": "personal",
        "provider": "openai",
        "no_account": false,
        "auto_account": false,
        "pool": null,
        "save_draft": false,
        "label_ids": ["l-urgent", "l-infra"],
