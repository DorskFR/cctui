{
  "name": "cctui-ghreview-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "preinstall": "case \"$npm_config_user_agent\" in bun*) exit 0 ;; esac; [ \"$INIT_CWD\" = \"$PWD\" ] || exit 0; echo '' >&2; echo 'ghreview-ui is a bun project (bun.lock, no package-lock.json).' >&2; echo 'Run: bun install' >&2; echo '' >&2; exit 1",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview --host",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "biome check .",
    "test": "vitest run",
    "check": "bun run typecheck && bun run lint && bun run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tsconfig/svelte": "^5.0.8",
    "happy-dom": "^20.11.1",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "typescript": "^5.9.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@dorsk/tsumikit": "^0.38.1",
    "@tanstack/svelte-query": "^6.1.38",
    "highlight.js": "^11.11.1",
    "marked": "^18.0.7"
  }
}
